# Onlook server the app talks to (the Next.js app in apps/web/client)
EXPO_PUBLIC_ONLOOK_URL=http://localhost:3000
# Same Supabase project as the web app (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Development builds only: prefill the sign-in form (e.g. the seeded demo user)
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
